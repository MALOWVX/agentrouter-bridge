# ==================================
# AgentRouter Bridge — Configuration
# ==================================

# Target AgentRouter URL (don't change unless you have a custom subdomain)
AGENTROUTER_BASE_URL=https://agentrouter.org

# Port for the proxy server (Railway sets this automatically)
PORT=3131

# Disguise mode: "claude-code" (recommended), "cursor", or "codex"
DISGUISE_MODE=claude-code

# Obfuscate mode: "zero-width" (inserts invisible zero-width spaces to bypass keyword filters), "base64", or "none"
OBFUSCATE_MODE=zero-width

# Optional: Override API key here instead of passing from JanitorAI
# If set, this key will be used instead of the one from JanitorAI
# AGENTROUTER_API_KEY=sk-your-key-here
